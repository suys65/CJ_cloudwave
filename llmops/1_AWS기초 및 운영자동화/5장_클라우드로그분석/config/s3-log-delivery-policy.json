{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3ServerAccessLogsPolicy",
      "Effect": "Allow",
      "Principal": {
        "Service": "logging.s3.amazonaws.com"
      },
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::kytu7-s3-logs-892880329905-ap-northeast-2/s3-access-logs/*",
      "Condition": {
        "ArnLike": {
          "aws:SourceArn": "arn:aws:s3:::kytu7-s3-source-892880329905-ap-northeast-2"
        },
        "StringEquals": {
          "aws:SourceAccount": "892880329905"
        }
      }
    }
  ]
}
